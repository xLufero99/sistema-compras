# Copiar este archivo como .env en la raíz del proyecto antes de
# ejecutar `docker compose up --build`.
# docker compose lo usa para resolver ${VAR} en docker-compose.yml.

# --- Base de datos (compartida por postgres y las 3 APIs) ---
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=sistema_compras
DB_HOST=db
DB_PORT=5432

# --- Comunicación entre servicios (red interna de Docker) ---
CLIENTE_API_URL=http://cliente-api:3001
PRODUCTO_API_URL=http://producto-api:3002

# --- Puertos expuestos ---
CLIENTE_API_PORT=3001
PRODUCTO_API_PORT=3002
COMPRA_API_PORT=3003
